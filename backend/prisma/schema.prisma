generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String                @id @default(uuid())
  nombre          String
  disfrazTag      String                @map("disfraz_tag")
  resumenCorto    String                @map("resumen_corto")
  imagenPrincipal String                @map("imagen_principal")
  precio          Decimal               @db.Decimal(10, 2)
  disponible      Boolean               @default(true)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  carouselItems   ProductCarouselItem[]

  @@map("products")
}

model ProductCarouselItem {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  tituloPaso  String   @map("titulo_paso")
  imagenUrl   String   @map("imagen_url")
  descripcion String   @db.Text
  orden       Int      @default(0)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, orden])
  @@map("product_carousel_items")
}
